{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["jest", "node"],
    "jsx": "react-jsx"
  },
  "include": ["src", ".storybook", "tests", "jest.setup.js"],
  "exclude": ["node_modules", "storybook-static"]
}
